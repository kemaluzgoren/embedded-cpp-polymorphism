# Usage: make [all|led_demo|sensor_demo|vtable_demo|door_demo|run|run-led|run-sensor|run-vtable|run-door|clean]
# (on Windows MinGW the command is mingw32-make)
# BOARD=host is the only target built here; stm32 needs an arm-none-eabi toolchain.

CXX      ?= g++
CXXFLAGS := -std=c++17 -g -O0 -Wall -Wextra -I. -MMD -MP
OUT      := out
# Objects live apart from the binaries: out/led_demo must not be a directory.
OBJ      := $(OUT)/obj
CMAKE  := cmake   # only used for portable mkdir/rm (-E), works in cmd and sh

ifeq ($(OS),Windows_NT)
  EXE := .exe
endif

LED_SRC    := led_demo/main.cpp led_demo/host/board_host.cpp
SENSOR_SRC := sensor_demo/main.cpp sensor_demo/app/temp_monitor.cpp \
              sensor_demo/host/board_host.cpp sensor_demo/host/host_temp_sensor.cpp
VTABLE_SRC := led_demo/vtable_demo.cpp
DOOR_SRC   := door_demo/main.cpp door_demo/app/pin_code.cpp door_demo/app/door_controller.cpp \
              door_demo/host/board_host.cpp door_demo/host/host_keypad.cpp door_demo/host/host_lock.cpp

LED_BIN    := $(OUT)/led_demo$(EXE)
SENSOR_BIN := $(OUT)/sensor_demo$(EXE)
VTABLE_BIN := $(OUT)/vtable_demo$(EXE)
DOOR_BIN   := $(OUT)/door_demo$(EXE)

.PHONY: all led_demo sensor_demo vtable_demo door_demo run run-led run-sensor run-vtable run-door clean

all: $(LED_BIN) $(SENSOR_BIN) $(VTABLE_BIN) $(DOOR_BIN)

led_demo:    $(LED_BIN)
sensor_demo: $(SENSOR_BIN)
vtable_demo: $(VTABLE_BIN)
door_demo:   $(DOOR_BIN)

$(LED_BIN):    $(LED_SRC:%.cpp=$(OBJ)/%.o)
$(SENSOR_BIN): $(SENSOR_SRC:%.cpp=$(OBJ)/%.o)
$(VTABLE_BIN): $(VTABLE_SRC:%.cpp=$(OBJ)/%.o)
$(DOOR_BIN):   $(DOOR_SRC:%.cpp=$(OBJ)/%.o)

$(LED_BIN) $(SENSOR_BIN) $(VTABLE_BIN) $(DOOR_BIN):
	$(CXX) $^ -o $@

$(OBJ)/%.o: %.cpp
	$(CMAKE) -E make_directory $(@D)
	$(CXX) $(CXXFLAGS) -c $< -o $@

run: run-led run-sensor run-vtable run-door

run-led: $(LED_BIN)
	$(LED_BIN)

run-sensor: $(SENSOR_BIN)
	$(SENSOR_BIN)

run-vtable: $(VTABLE_BIN)
	$(VTABLE_BIN)

run-door: $(DOOR_BIN)
	$(DOOR_BIN)

clean:
	$(CMAKE) -E remove_directory $(OUT)


# Header dependency tracking (generated by -MMD)
ALL_OBJ := $(LED_SRC:%.cpp=$(OBJ)/%.o) $(SENSOR_SRC:%.cpp=$(OBJ)/%.o) $(VTABLE_SRC:%.cpp=$(OBJ)/%.o) $(DOOR_SRC:%.cpp=$(OBJ)/%.o)
-include $(ALL_OBJ:.o=.d)
